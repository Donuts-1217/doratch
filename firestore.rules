rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function currentRole() {
      return request.auth != null
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    // Developer：最高權限
    function isDeveloper() {
      return request.auth != null && (
        currentRole() == 'developer' ||
        request.auth.token.email == 'chianghansen0302@gmail.com'
      );
    }

    // Admin：次高權限（可管理多數功能）
    function isAdmin() {
      return request.auth != null && (
        isDeveloper() ||
        currentRole() == 'admin'
      );
    }

    // 輔助函式：檢查是否為老師
    function isTeacher() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        isAdmin()
      );
    }

    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 一般使用者不可自行修改敏感欄位（角色、配額設定）
    function selfTouchesProtectedUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role',
        'subscription',
        'cloudStorageLimitMB',
        'cloudStorageMaxFiles',
        'reviewUploadDailyLimit',
        'reviewUploadBonusToday'
      ]);
    }

    // Docoin 僅能由管理端發放；一般使用者只能維持或扣減（例如兌換/消耗）
    function selfDocoinNotIncreased() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['docoin']) ||
        request.resource.data.docoin <= (('docoin' in resource.data) ? resource.data.docoin : 0);
    }

    // 1. 使用者中心 (users)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        isDeveloper() ||
        (
          isAdmin() &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
            request.resource.data.role in ['student', 'teacher', 'admin']
          )
        ) ||
        (
          isSelf(userId) &&
          !selfTouchesProtectedUserFields() &&
          selfDocoinNotIncreased() &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
            request.resource.data.role == resource.data.role
          )
        )
      );
      allow delete: if isAdmin();

      // 1.1 使用者專案 (projects)
      match /projects/{projectId} {
        allow read: if resource == null || resource.data.isPublic == true || request.auth.uid == userId || isAdmin();
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /gameSurvival/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      match /gameClicker/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /gameRpg/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /gameCards/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /gamePet/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /gameMine/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /gameSessions/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /pythonProgress/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Discord Bot 創作（Python 創作空間部署）
      match /discordBots/{botId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Bot Token 索引（交流大廳用 Token 連接 Bot）
    match /botTokens/{token} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.auth.uid == request.resource.data.ownerId;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerId;
    }

    // 全域專案索引 (用於探索牆)
    match /{path=**}/projects/{projectId} {
      allow read: if resource.data.isPublic == true;
    }

    // 2. 班級與任務系統 (classes)
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null; // 暫時允許所有人創建，未來可限縮為只有 teacher 角色
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.teacherId || 
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['students']) &&
          request.auth.uid in request.resource.data.students
        ) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classAnnouncement', 'announcementAt']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['className'])
      );
      allow delete: if request.auth != null && (request.auth.uid == resource.data.teacherId || isAdmin());

      match /survivalScores/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid;
      }

      // 2.1 班級任務 (assignments)
      match /assignments/{assignmentId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/classes/$(classId)).data.teacherId ||
          isAdmin()
        );

        // 2.2 學生繳交清單 (submissions)
        match /submissions/{studentId} {
          allow read: if request.auth != null && (
            request.auth.uid == studentId || 
            request.auth.uid == get(/databases/$(database)/documents/classes/$(classId)).data.teacherId ||
            isAdmin()
          );
          allow write: if request.auth != null && (request.auth.uid == studentId || isAdmin());

          match /comments/{commentId} {
            allow read: if request.auth != null && (
              request.auth.uid == studentId ||
              request.auth.uid == get(/databases/$(database)/documents/classes/$(classId)).data.teacherId ||
              isAdmin()
            );
            allow create: if request.auth != null && (
              request.auth.uid == studentId ||
              request.auth.uid == get(/databases/$(database)/documents/classes/$(classId)).data.teacherId ||
              isAdmin()
            );
          }
        }
      }
    }

    // 3. 聊天系統 (chats)
    match /chats/{chatId} {
      // 伺服器型聊天或私訊
      allow read: if request.auth != null && (
        resource.data.type == 'server' || 
        resource.data.type == 'public' ||
        (request.auth.uid in resource.data.participants) ||
        isAdmin()
      );
      allow create: if request.auth != null && (
        isAdmin() ||
        request.resource.data.type != 'server'
      );
      allow update: if request.auth != null && (
        (request.auth.uid in resource.data.participants) ||
        isAdmin() ||
        (
          resource.data.type == 'group' &&
          request.auth.uid in request.resource.data.participants &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['participants', 'lastMessage', 'updatedAt'])
        ) ||
        (
          (resource.data.type == 'group' || resource.data.type == 'server') &&
          request.auth.uid in resource.data.participants &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['attachedBots', 'lastMessage', 'updatedAt'])
        )
      );
      allow delete: if isAdmin() || (resource.data.type == 'server' && request.auth.uid == resource.data.teacherId) ||
        (resource.data.type == 'private' && request.auth.uid in resource.data.participants);

      match /messages/{messageId} {
        allow read: if request.auth != null; // 簡化處理，具備 chat 讀取權限者通常可讀
        allow write: if request.auth != null;
      }
    }

    // 3.1 好友請求 / 好友關係
    match /friend_requests/{requestId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid ||
        isAdmin()
      );

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.fromUid &&
        request.resource.data.toUid is string &&
        request.resource.data.fromUid != request.resource.data.toUid;

      allow update: if request.auth != null && (
        isAdmin() ||
        (
          request.auth.uid == resource.data.toUid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedAt', 'updatedAt']) &&
          request.resource.data.status in ['accepted']
        )
      );

      allow delete: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
    }

    // 4. 全域資源 (Global Assets)
    
    // 題庫 (questions)
    match /questions/{qId} {
      allow read: if request.auth != null;
      allow write: if isTeacher() || isAdmin();
    }

    // 公告 (announcements)
    match /announcements/{annId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 管理日誌 (adminLogs)
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    // 兼容舊版命名
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // 6. 挑戰區全服榜（固定地圖題組 + 各使用者分數）
    match /globalChallenges/{challengeId} {
      allow read: if request.auth != null && challengeId == "fixed_arcade_v1";
      allow create: if request.auth != null && challengeId == "fixed_arcade_v1";
      allow update: if isAdmin() && challengeId == "fixed_arcade_v1";
      allow delete: if isAdmin();

      match /scores/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null &&
          request.auth.uid == uid &&
          challengeId == "fixed_arcade_v1";
        allow delete: if isAdmin();
      }
    }

    // 7. 遊戲與對戰 (Gaming)
    
    // 競技場對戰房 (duels)
    match /duels/{roomId} {
      allow read, write: if request.auth != null;
    }

    // 商店物品定義 (若有)
    match /mall_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 系統設定（例如預設雲端容量）
    match /system_config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 程式作品送審（金幣核發）
    match /coin_review_requests/{requestId} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow read: if request.auth != null && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );

      // 一般使用者只能補充註記，不可動狀態；管理員可審核狀態與核發金額
      allow update: if request.auth != null && (
        (
          isSelf(resource.data.userId) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.status == resource.data.status
        ) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // 伺服器建立申請（使用者申請，管理員審核後建立）
    match /server_create_requests/{requestId} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.serverName is string &&
        request.resource.data.serverName.size() >= 2 &&
        request.resource.data.serverName.size() <= 40;

      allow read: if request.auth != null && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // 客服工單
    match /support_tickets/{ticketId} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.subject is string &&
        request.resource.data.subject.size() >= 2 &&
        request.resource.data.subject.size() <= 80 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 5 &&
        request.resource.data.message.size() <= 2000;

      allow read: if request.auth != null && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }
  }
}
